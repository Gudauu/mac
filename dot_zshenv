. "$HOME/.cargo/env"
export PATH=$HOME/Documents/dependencies/flutter/bin:$PATH
export ANDROID_HOME=/Users/$USER/Library/Android/sdk
export PATH=$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools
export NO_MISTAKES_TELEMETRY=0

# Here rather than .zshrc so non-interactive zsh gets them too. Note this does
# NOT reach herdr's edit_scrollback: that runs under /bin/sh, which reads no zsh
# rc files at all. Its copy of these lives in the launchd plist, see
# ~/Library/LaunchAgents/homebrew.mxcl.herdr.plist.
#
# Use an absolute editor path on both Apple Silicon and Intel Homebrew installs.
# Herdr's background service records this value when `brew services start herdr`
# creates its launchd plist.
if [[ -x /opt/homebrew/bin/nvim ]]; then
  export EDITOR=/opt/homebrew/bin/nvim
elif [[ -x /usr/local/bin/nvim ]]; then
  export EDITOR=/usr/local/bin/nvim
else
  export EDITOR=nvim
fi
export VISUAL="$EDITOR"
export LANG=en_US.UTF-8
