# Shared interactive Zsh configuration managed by chezmoi.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

# Keep syntax highlighting near the end and history substring search after it.
plugins=(
  git
  docker
  zsh-autosuggestions
  zsh-completions
  zsh-syntax-highlighting
  zsh-history-substring-search
)

source "$ZSH/oh-my-zsh.sh"

# Device-specific paths, runtimes, and key bindings stay off the shared config.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
